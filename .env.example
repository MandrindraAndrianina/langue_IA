# ============================================================
# CENTRE DE LANGUES IA — Variables d'environnement
# ============================================================
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS COMMITER le fichier .env
#
# Avec Docker (docker compose up) : les *_HOST et DATABASE_URL ci-dessous sont remplacés
# par les noms des conteneurs (db, redis, ia-service) dans docker-compose.yml.
# BACKEND_PORT, IA_PORT et FRONTEND_PORT sont les ports ouverts sur votre machine : changez-les s'ils sont pris.
# PostgreSQL et Redis ne sont pas ouverts (sauf en mode dev : POSTGRES_HOST_PORT, REDIS_HOST_PORT).
# ============================================================

# ===== Base de données PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=centre_langues
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://admin:changeme@localhost:5432/centre_langues
# Docker, mode dev uniquement : port de la base sur votre machine (pgAdmin, DBeaver)
POSTGRES_HOST_PORT=55432

# ===== Backend FastAPI =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=changeme_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
# Doit contenir l'adresse du frontend (changer le port si FRONTEND_PORT change)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Adresse du frontend, utilisée dans les liens envoyés par e-mail (mot de passe oublié)
FRONTEND_URL=http://localhost:3000
# Comptes de démonstration (admin@digitheque.mg… / Demo2026) créés au démarrage : false en production
SEED_DEMO=true
# Fuseau des statistiques par jour (tableau de bord)
TIMEZONE=Indian/Antananarivo

# ===== Frontend Next.js =====
# En local (npm run dev), le frontend lit frontend/.env.development puis frontend/.env.local, pas ce fichier.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_IA_URL=http://localhost:8001
# false : le frontend appelle le backend (qui implémente docs/api/contrat-frontend.md).
# true : données simulées de frontend/src/mocks, pour travailler sur le frontend sans backend.
# Docker : intégrée au build du frontend, relancer `docker compose up --build` après un changement.
NEXT_PUBLIC_API_MOCK=false
FRONTEND_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme_nextauth_secret

# ===== IA Service =====
IA_HOST=0.0.0.0
IA_PORT=8001

# ===== OpenAI (Chatbot) =====
OPENAI_API_KEY=changeme
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# ===== Modèles IA locaux =====
MODEL_DIAGNOSTIC_PATH=./models/diagnostic.pkl
MODEL_RECO_PATH=./models/recommandation.pkl

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Docker, mode dev uniquement : port de Redis sur votre machine
REDIS_HOST_PORT=56379

# ===== Email (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme
SMTP_FROM=noreply@centre-langues.mg

# ===== Environnement =====
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# ===== Sécurité =====
BCRYPT_ROUNDS=12
# Anti brute force : tentatives de connexion autorisées par IP sur la fenêtre (en secondes)
RATE_LIMIT_LOGIN_TENTATIVES=5
RATE_LIMIT_LOGIN_FENETRE_SECONDES=60

# ===== Sauvegarde =====
BACKUP_ENABLED=True
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30